# Copy to .env and adjust. Every value here is a safe local-development default, and every
# variable the code reads appears here with a line saying what it is for.
#
# Nothing secret belongs in this file or in the repository.

# PostgreSQL from `make db`. Port 15432 keeps clear of the other local projects
# (Slip 5434, Portfolio 5432, open-mt2's MySQL 13306).
DATABASE_URL=postgres://mt2go:mt2go@localhost:15432/mt2go

# Where the two ports listen. The game client's serverinfo.py points at 11002 (auth) and
# 13001 (game), the same ports open-mt2 uses, so only one of the two servers runs at a time.
AUTH_LISTEN=127.0.0.1:11002
GAME_LISTEN=127.0.0.1:13001

# The game address the client is told to connect to after login. It must be reachable
# from the client, so set it to the machine's LAN address when listening on 0.0.0.0.
GAME_PUBLIC_ADDRESS=127.0.0.1

# true turns on /getitem and /getyang in the game's chat, which hand any player items and
# yang for testing. Never on a server others play on.
DEV_COMMANDS=false

# Integration tests run against this database and wipe its tables; never point it at
# data you want to keep. Unset, they fail; `go test -short ./...` skips them instead.
TEST_DATABASE_URL=postgres://mt2go:mt2go@localhost:15432/mt2go_test
